# Chạy không cần Docker: systemd unit (đặt tại /etc/systemd/system/chrome-bridge.service)
#   sudo systemctl daemon-reload && sudo systemctl enable --now chrome-bridge
# Vẫn cần reverse proxy TLS (Caddy/nginx) phía trước cổng 8787.
#
# ⚠️  MÔ HÌNH CŨ — không còn dùng từ 3.5.0.
# Từ 3.5.0 mỗi người tự chạy bridge trên máy mình (xem scripts/install.sh).
# File này giữ lại cho ai vẫn đang chạy mô hình server chung.
# Lưu ý: unit này đặt CC_CHROME_HOST=127.0.0.1 vì có reverse proxy đứng trước —
# đó KHÔNG phải là "chỉ máy này gọi được", và /panel sẽ từ chối (mã 4004) vì
# cổng chặn còn kiểm địa chỉ peer và các header X-Forwarded-*.
[Unit]
Description=Claude Code Chrome Bridge MCP server (http mode)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/cc-chrome-extension/server
Environment=CC_CHROME_MODE=http
Environment=CC_CHROME_PORT=8787
Environment=CC_CHROME_HOST=127.0.0.1
# Lưu ý: bind loopback ở đây KHÔNG bật khung chat side panel. Server chỉ mở
# /panel khi không ai ngoài chính máy đó tới được — bind loopback, peer là
# loopback, và request không mang X-Forwarded-*. Bản deploy này có proxy đứng
# trước nên luôn bị từ chối (mã 4004), đúng như thiết kế: sau /panel là một
# tiến trình `claude` chạy bằng tài khoản đăng nhập trên chính host này.
# Server đứng sau reverse proxy (Caddy/nginx) nên IP thật nằm ở X-Forwarded-For.
#
# GIẢ ĐỊNH: proxy đứng trước PHẢI là thứ ghi đè hoặc nối thêm X-Forwarded-For.
#   - nginx:  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;  (nối thêm)
#   - Caddy:  reverse_proxy ... (2.7+ ghi đè header client gửi)
# Server đọc entry CUỐI CÙNG của header (entry do proxy kề bên nối vào — xem
# clientIp trong server/ratelimit.js), nên cả hai kiểu đều đúng. Proxy nào chỉ
# forward nguyên header của client thì rate limit của /pair sẽ vô hiệu.
#
# CC_CHROME_TRUST_PROXY=1 chỉ an toàn khi cổng 8787 không tới được từ đâu khác
# ngoài proxy đó — giữ CC_CHROME_HOST=127.0.0.1 như dưới đây, và đừng mở 8787
# trên firewall. Nếu 8787 lộ ra ngoài, ai cũng tự đặt được X-Forwarded-For và
# bypass được rate limit.
Environment=CC_CHROME_TRUST_PROXY=1
# Sinh secret/token: openssl rand -hex 16
# Bật pairing tự phục vụ cho /ccchrome connect:
Environment=CC_CHROME_PAIR_SECRET=DOI_SECRET_NAY_openssl_rand_hex_16
Environment=CC_CHROME_STATE_FILE=/opt/cc-chrome-extension/server/ccchrome-tokens.json
# Tùy chọn, token tĩnh cấp thủ công:
#Environment=CC_CHROME_TOKENS=DOI_TOKEN_NAY=alice,DOI_TOKEN_KIA=bob
ExecStart=/usr/bin/node index.js --http
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
