# Copy thành .env rồi sửa. KHÔNG commit file .env.
#
#   cp .env.example .env
#   openssl rand -hex 16    # chạy để sinh từng giá trị bên dưới

# Bật pairing tự phục vụ: thành viên tự lấy token bằng `/ccchrome connect`.
# Tối thiểu 12 ký tự, server từ chối giá trị yếu hơn.
# CẢNH BÁO: xoá biến này sau khi team đã pair sẽ làm MẤT toàn bộ token đã cấp.
# Muốn tắt pairing thì phải chuyển token sang CC_CHROME_TOKENS trước —
# xem mục "Bẫy đã biết" trong docs/deploy-cloudflare-tunnel.md.
CC_CHROME_PAIR_SECRET=doi-gia-tri-nay-bang-openssl-rand-hex-16

# Token tĩnh cấp tay, dùng thay cho hoặc song song với pairing.
# Định dạng: token=tên, cách nhau bằng dấu phẩy. Mỗi token tối thiểu 8 ký tự.
# CC_CHROME_TOKENS=a1b2c3d4e5f6a7b8=huy,9f8e7d6c5b4a3210=nam

# Trần số token động. Với team 2-5 người thì 20 là rộng rãi.
CC_CHROME_MAX_TOKENS=20

# Session MCP không hoạt động quá lâu sẽ bị đóng. Mặc định 8 tiếng.
# CC_CHROME_SESSION_TTL_MS=28800000
